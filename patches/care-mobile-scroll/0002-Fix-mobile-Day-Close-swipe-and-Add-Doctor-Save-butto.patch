 .../diagnostic-erp/src/pages/BillDetail.tsx   |  4 ++++
 .../diagnostic-erp/src/pages/DayClose.tsx     | 24 +++++++++----------
 .../diagnostic-erp/src/pages/Doctors.tsx      |  4 ++--
 .../diagnostic-erp/src/pages/OrderDetail.tsx  |  2 ++
