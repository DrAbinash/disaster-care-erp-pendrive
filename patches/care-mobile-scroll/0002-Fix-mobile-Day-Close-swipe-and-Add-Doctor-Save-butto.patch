 10 files changed, 55 insertions(+), 28 deletions(-)

diff --git a/artifacts/diagnostic-erp/src/components/ModuleErrorBoundary.tsx b/artifacts/diagnostic-erp/src/components/ModuleErrorBoundary.tsx
index 98061104..c332cd8e 100644
--- a/artifacts/diagnostic-erp/src/components/ModuleErrorBoundary.tsx
